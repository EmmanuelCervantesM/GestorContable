    <field name="saldoPasivo" class="java.math.BigDecimal"/>

    <variable name="V_TOTAL_ACTIVO" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[
            ($F{cuentaActivo} != null
                && $F{cuentaActivo}.trim().equals("100")
                && $F{saldoActivo} != null)
            ? $F{saldoActivo}
            : java.math.BigDecimal.ZERO
        ]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <variable name="V_TOTAL_PASIVO_CAPITAL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[
            ($F{cuentaPasivo} != null
                && (
                    $F{cuentaPasivo}.trim().equals("200")
                    || $F{cuentaPasivo}.trim().equals("300")
                )
                && $F{saldoPasivo} != null)
            ? $F{saldoPasivo}
            : java.math.BigDecimal.ZERO
        ]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

